# --- ESP32-P4 (Waveshare ESP32-P4-ETH) --------------------------------------
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Kamera: OV5640 an MIPI-CSI
CONFIG_CAMERA_OV5640=y
CONFIG_CAMERA_OV5640_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
# DVP-, SPI- und USB-Kameras werden nicht gebraucht
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=n

# Ethernet: interne EMAC
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_DMA_TX_BUFFER_NUM=20
CONFIG_ETH_DMA_RX_BUFFER_NUM=20

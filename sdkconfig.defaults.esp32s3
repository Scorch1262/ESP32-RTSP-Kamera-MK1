# --- ESP32-S3 (Waveshare ESP32-S3-ETH, ESP32-S3R8: 8 MB Octal-PSRAM, 16 MB Flash) ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Ethernet: W5500 an SPI
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# Kamera: esp32-camera, Bildpuffer im PSRAM
CONFIG_OV5640_SUPPORT=y
CONFIG_OV2640_SUPPORT=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
CONFIG_CAMERA_CORE0=n
CONFIG_CAMERA_CORE1=y

# Datencache fuer PSRAM-Durchsatz
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Gemeinsame Einstellungen fuer ESP32-P4 und ESP32-S3
# (zielabhaengige Werte: sdkconfig.defaults.esp32p4 / sdkconfig.defaults.esp32s3)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SPIRAM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Bei einem Absturz 10 s warten, damit die Meldung im seriellen Monitor lesbar bleibt
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=10

# --- lwIP: groessere Puffer fuer Video --------------------------------------
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCPIP_TASK_PRIO=20
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_MAX_SOCKETS=24

# --- MicroSD: lange Dateinamen, schnellere Schreibzugriffe --------------------
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096
CONFIG_FATFS_IMMEDIATE_FSYNC=n

# --- Webserver ----------------------------------------------------------------
CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
